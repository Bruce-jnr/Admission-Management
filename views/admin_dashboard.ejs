<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - Admission Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="#">
          <i class="fas fa-graduation-cap me-2"></i>
          Admission Management
        </a>
        <div class="navbar-nav ms-auto">
          <form method="POST" action="/logout" class="d-inline">
            <button type="submit" class="btn btn-outline-light">
              <i class="fas fa-sign-out-alt me-1"></i>
              Logout
            </button>
          </form>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row">
        <div class="col-12">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-users me-2"></i>Student Management</h2>
            <div class="btn-group">
              <button
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#addStudentModal"
              >
                <i class="fas fa-plus me-2"></i>Add Student
              </button>
              <button
                class="btn btn-warning"
                id="bulkAdmitBtn"
                onclick="bulkAdmitAll()"
              >
                <i class="fas fa-users me-2"></i>Admit All Pending
                <span class="badge bg-light text-dark ms-1" id="pendingCount">
                  <%= students.filter(s => !s.admitted).length %>
                </span>
              </button>
            </div>
          </div>

          <!-- Filter Buttons -->
          <div class="mb-3">
            <div class="btn-group" role="group">
              <button
                type="button"
                class="btn btn-outline-primary active"
                onclick="filterStudents('all')"
                id="filterAll"
              >
                <i class="fas fa-list me-1"></i>All Students
              </button>
              <button
                type="button"
                class="btn btn-outline-warning"
                onclick="filterStudents('pending')"
                id="filterPending"
              >
                <i class="fas fa-clock me-1"></i>Pending
              </button>
              <button
                type="button"
                class="btn btn-outline-success"
                onclick="filterStudents('admitted')"
                id="filterAdmitted"
              >
                <i class="fas fa-check me-1"></i>Admitted
              </button>
            </div>
            <span class="ms-3 text-muted" id="studentCount">
              Showing all students
            </span>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead class="table-dark">
                    <tr>
                      <th>Admission Number</th>
                      <th>Full Name</th>
                      <th>Phone Number</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (students.length === 0) { %>
                    <tr>
                      <td colspan="5" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i><br />
                        No students found. Add some students to get started.
                      </td>
                    </tr>
                    <% } else { %> <% students.forEach(function(student) { %>
                    <tr>
                      <td><%= student.admission_number %></td>
                      <td><%= student.full_name %></td>
                      <td><%= student.phone_number %></td>
                      <td>
                        <% if (student.admitted) { %>
                        <span class="badge bg-success">
                          <i class="fas fa-check me-1"></i>Admitted
                        </span>
                        <% } else { %>
                        <span class="badge bg-warning">
                          <i class="fas fa-clock me-1"></i>Pending
                        </span>
                        <% } %>
                      </td>
                      <td>
                        <% if (!student.admitted) { %>
                        <button
                          class="btn btn-primary btn-sm admit-btn"
                          data-id="<%= student.id %>"
                          data-name="<%= student.full_name %>"
                        >
                          <i class="fas fa-user-check me-1"></i>Admit
                        </button>
                        <% } else { %>
                        <span class="text-success">
                          <i class="fas fa-check-circle me-1"></i>Admitted
                        </span>
                        <% } %>
                      </td>
                    </tr>
                    <% }); %> <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Student Modal -->
    <div class="modal fade" id="addStudentModal" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Add New Student</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <form id="addStudentForm">
            <div class="modal-body">
              <div class="mb-3">
                <label for="admissionNumber" class="form-label"
                  >Admission Number</label
                >
                <input
                  type="text"
                  class="form-control"
                  id="admissionNumber"
                  name="admission_number"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="fullName" class="form-label">Full Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="fullName"
                  name="full_name"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="phoneNumber" class="form-label">Phone Number</label>
                <input
                  type="tel"
                  class="form-control"
                  id="phoneNumber"
                  name="phone_number"
                  required
                />
              </div>
            </div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Cancel
              </button>
              <button type="submit" class="btn btn-primary">Add Student</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Success/Error Toast -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
      <div id="alertToast" class="toast" role="alert">
        <div class="toast-header">
          <i class="fas fa-info-circle text-primary me-2"></i>
          <strong class="me-auto">Notification</strong>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="toast"
          ></button>
        </div>
        <div class="toast-body" id="toastMessage">
          <!-- Message will be inserted here -->
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      // Add Student Form
      document
        .getElementById('addStudentForm')
        .addEventListener('submit', async function (e) {
          e.preventDefault();

          const formData = new FormData(this);
          const data = Object.fromEntries(formData);

          try {
            const response = await fetch('/admin/add-student', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(data),
            });

            const result = await response.json();

            if (result.success) {
              showToast('Student added successfully!', 'success');
              setTimeout(() => location.reload(), 1500);
            } else {
              showToast(result.message || 'Error adding student', 'error');
            }
          } catch (error) {
            showToast('Error adding student', 'error');
          }
        });

      // Admit Student
      document.querySelectorAll('.admit-btn').forEach((button) => {
        button.addEventListener('click', async function () {
          const studentId = this.dataset.id;
          const studentName = this.dataset.name;

          if (
            confirm(
              `Are you sure you want to admit ${studentName}? This will send an SMS notification.`
            )
          ) {
            try {
              const response = await fetch(`/admit/${studentId}`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
              });

              const result = await response.json();

              if (result.success) {
                showToast(result.message, 'success');
                setTimeout(() => location.reload(), 1500);
              } else {
                showToast(result.message || 'Error admitting student', 'error');
              }
            } catch (error) {
              showToast('Error admitting student', 'error');
            }
          }
        });
      });

      // Filter Students
      function filterStudents(filter) {
        const rows = document.querySelectorAll('tbody tr');
        const filterButtons = document.querySelectorAll('.btn-group button');
        const studentCount = document.getElementById('studentCount');
        let visibleCount = 0;

        // Remove active class from all filter buttons
        filterButtons.forEach((btn) => btn.classList.remove('active'));

        // Add active class to clicked button
        document
          .getElementById(
            `filter${filter.charAt(0).toUpperCase() + filter.slice(1)}`
          )
          .classList.add('active');

        rows.forEach((row) => {
          const statusBadge = row.querySelector('.badge');
          const isAdmitted =
            statusBadge && statusBadge.textContent.includes('Admitted');

          if (filter === 'all') {
            row.style.display = '';
            visibleCount++;
          } else if (filter === 'pending' && !isAdmitted) {
            row.style.display = '';
            visibleCount++;
          } else if (filter === 'admitted' && isAdmitted) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Update count display
        if (filter === 'all') {
          studentCount.textContent = `Showing all ${visibleCount} students`;
        } else if (filter === 'pending') {
          studentCount.textContent = `Showing ${visibleCount} pending students`;
        } else if (filter === 'admitted') {
          studentCount.textContent = `Showing ${visibleCount} admitted students`;
        }
      }

      // Bulk Admit All Pending Students
      async function bulkAdmitAll() {
        const pendingStudents =
          document.querySelectorAll('tbody tr').length -
          document.querySelectorAll('.badge.bg-success').length;

        if (pendingStudents === 0) {
          showToast('No pending students to admit', 'info');
          return;
        }

        if (
          confirm(
            `Are you sure you want to admit all ${pendingStudents} pending students? This will send SMS notifications to all of them.`
          )
        ) {
          const bulkBtn = document.getElementById('bulkAdmitBtn');
          const originalText = bulkBtn.innerHTML;

          // Show loading state
          bulkBtn.innerHTML =
            '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
          bulkBtn.disabled = true;

          try {
            const response = await fetch('/admin/bulk-admit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            });

            const result = await response.json();

            if (result.success) {
              showToast(result.message, 'success');
              setTimeout(() => location.reload(), 2000);
            } else {
              showToast(result.message || 'Error admitting students', 'error');
            }
          } catch (error) {
            showToast('Error admitting students', 'error');
          } finally {
            // Restore button state
            bulkBtn.innerHTML = originalText;
            bulkBtn.disabled = false;
          }
        }
      }

      // Toast notification
      function showToast(message, type) {
        const toast = document.getElementById('alertToast');
        const toastMessage = document.getElementById('toastMessage');
        const toastHeader = toast.querySelector('.toast-header');

        toastMessage.textContent = message;

        // Update icon and color based on type
        const icon = toastHeader.querySelector('i');
        if (type === 'success') {
          icon.className = 'fas fa-check-circle text-success me-2';
        } else if (type === 'error') {
          icon.className = 'fas fa-exclamation-triangle text-danger me-2';
        } else if (type === 'info') {
          icon.className = 'fas fa-info-circle text-info me-2';
        }

        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
      }
    </script>
  </body>
</html>
