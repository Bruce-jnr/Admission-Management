<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard - Admission Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="#">
          <i class="fas fa-user-graduate me-2"></i>
          Student Portal
        </a>
        <div class="navbar-nav ms-auto">
          <form method="POST" action="/logout" class="d-inline">
            <button type="submit" class="btn btn-outline-light">
              <i class="fas fa-sign-out-alt me-1"></i>
              Logout
            </button>
          </form>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row">
        <div class="col-12">
          <!-- Welcome Section -->
          <div class="card mb-4">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-md-8">
                  <h2 class="mb-1">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Welcome, <%= student.full_name %>!
                  </h2>
                  <p class="text-muted mb-0">
                    Admission Number:
                    <strong><%= student.admission_number %></strong>
                  </p>
                  <p class="text-success mb-0">
                    <i class="fas fa-graduation-cap me-1"></i>
                    Congratulations! You have been admitted.
                  </p>
                </div>
                <div class="col-md-4 text-md-end">
                  <div class="badge bg-success fs-6">
                    <i class="fas fa-star me-1"></i>
                    Admitted Student
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Documents Section -->
          <div class="row">
            <div class="col-12">
              <h3 class="mb-4">
                <i class="fas fa-download me-2"></i>
                Your Admission Documents
              </h3>
            </div>
          </div>

          <div class="row g-4">
            <!-- Admission Letter -->
            <div class="col-md-6">
              <div class="card h-100 border-primary">
                <div class="card-body text-center">
                  <i class="fas fa-file-alt fa-3x text-primary mb-3"></i>
                  <h5 class="card-title">Admission Letter</h5>
                  <p class="card-text text-muted">
                    View your personalized admission letter with all the details
                    about your admission.
                  </p>
                  <a
                    href="/student/admission-letter"
                    class="btn btn-primary"
                    target="_blank"
                  >
                    <i class="fas fa-eye me-2"></i>
                    View Letter
                  </a>
                </div>
              </div>
            </div>

            <!-- Admission Prospectus -->
            <div class="col-md-6">
              <div class="card h-100 border-success">
                <div class="card-body text-center">
                  <i class="fas fa-book fa-3x text-success mb-3"></i>
                  <h5 class="card-title">Admission Prospectus</h5>
                  <p class="card-text text-muted">
                    Download the official admission prospectus.
                  </p>
                  <a
                    href="/student/download/prospectus"
                    class="btn btn-success"
                  >
                    <i class="fas fa-download me-2"></i>
                    Download PDF
                  </a>
                </div>
              </div>
            </div>

            <!-- Acceptance Letter -->
            <div class="col-md-6">
              <div class="card h-100 border-info">
                <div class="card-body text-center">
                  <i class="fas fa-certificate fa-3x text-info mb-3"></i>
                  <h5 class="card-title">Acceptance Letter</h5>
                  <p class="card-text text-muted">
                    Download your official acceptance letter confirming your
                    admission to the institution with all necessary details.
                  </p>
                  <a href="/student/download/acceptance" class="btn btn-info">
                    <i class="fas fa-download me-2"></i>
                    Download Acceptance Letter
                  </a>
                </div>
              </div>
            </div>

            <!-- Contact Information -->
            <div class="col-md-6">
              <div class="card h-100 border-warning">
                <div class="card-body text-center">
                  <i class="fas fa-phone fa-3x text-warning mb-3"></i>
                  <h5 class="card-title">Need Help?</h5>
                  <p class="card-text text-muted">
                    Contact our admissions office for any questions or
                    assistance with your admission.
                  </p>
                  <div class="mt-3">
                    <p class="mb-1">
                      <strong>Phone:</strong> +233546535902 / 0547266259
                    </p>
                    <p class="mb-0">
                      <strong>Email:</strong> info@nsacoe.edu.gh
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Important Information -->
          <div class="row mt-5 mb-4">
            <div class="col-12">
              <div class="card border-info">
                <div class="card-header bg-info text-white">
                  <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Important Information
                  </h5>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6">
                      <h6>
                        <i class="fas fa-calendar-alt me-2"></i>Important Dates
                      </h6>
                      <ul class="list-unstyled">
                        <li>
                          <strong>Registration:</strong> November 10th, 2025
                        </li>
                        <li><strong>Orientation:</strong> To be announced</li>
                        <li>
                          <strong>Classes Begin:</strong> November 14, 2024
                        </li>
                      </ul>
                    </div>
                    <div class="col-md-6">
                      <h6>
                        <i class="fas fa-exclamation-triangle me-2"></i>Next
                        Steps
                      </h6>
                      <ul class="list-unstyled">
                        <li>Submit all required documents</li>
                        <li>Pay tuition fees according to schedule</li>
                        <li>
                          Send a copy of you payment receipt to the Finance
                          Officer via <strong>WhatsApp</strong> to
                          <strong>0597671371</strong> and
                          <strong>0263742044</strong>
                        </li>
                        <li>Attend mandatory orientation</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
